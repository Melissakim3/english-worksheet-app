# AI 키는 서버(api/ai.js)만 씀 — 이름에 VITE_를 붙이지 마세요 (VITE_가 붙으면 화면 파일에 키가 그대로 들어가 누구나 볼 수 있음)
# Claude 모델 사용 시 (Haiku, Sonnet 등)
ANTHROPIC_API_KEY=여기에_Anthropic_API_키_입력

# GPT 모델 사용 시 (gpt-4.1-mini, gpt-4.1 등)
OPENAI_API_KEY=여기에_OpenAI_API_키_입력

# 앱 비밀번호 — 정하면 AI · PDF를 쓸 때 한 번 물어봄 (주소를 알아도 남이 못 씀)
APP_PASSWORD=
